# Cấu hình đường dẫn đẹp (Pretty URLs) cho Cổng hỗ trợ bệnh viện
RewriteEngine On

# 1. Tự động chuyển hướng 301 để ẩn đuôi .php khi người dùng truy cập trực tiếp bằng file .php (Bỏ qua các yêu cầu POST/API)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Xử lý chạy ngầm: Tự động ánh xạ đường dẫn không đuôi (.php) sang file vật lý tương ứng
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [NC,L]
